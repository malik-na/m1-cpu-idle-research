+		return -1;
+	}
+	/* No recorder reference or RCU read section crosses deep WFI. */
+	instrumentation_begin();
+	observer_token = apple_apsc_observer_idle_enter();
+	instrumentation_end();
+#else
 	if (cpu_pm_enter())
 		return -1;
+#endif
 
 	ct_cpuidle_enter();
 
@@ -88,6 +107,12 @@ static __cpuidle int apple_enter_idle(struct cpuidle_device *dev, struct cpuidle
 
 	ct_cpuidle_exit();
 
+#ifdef CONFIG_ARM_APPLE_APSC_OBSERVER
+	instrumentation_begin();
+	apple_apsc_observer_idle_exit(observer_token);
+	instrumentation_end();
+#endif
+
 	cpu_pm_exit();
 
 	return index;
