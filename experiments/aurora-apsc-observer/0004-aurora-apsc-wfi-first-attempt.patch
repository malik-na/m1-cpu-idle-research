+static int apsc_wfi_events_show(struct seq_file *s, void *unused)
+{
+	struct apsc_wfi_stream *stream;
+	struct apsc_wfi_sample *e;
+	u32 slots, i;
+	int cpu;
+
+	if (!mutex_trylock(&capture_lock))
