+void *apple_apsc_observer_wfi_prepare(u64 token)
+{
+	struct apsc_wfi_sample *sample = NULL;
+	struct apsc_wfi_stream *stream;
+	int cpu, cluster, index;
+
+	/* A preempt-disabled RCU-sched reader, paired with capture shutdown. */
+	preempt_disable_notrace();
+	cpu = raw_smp_processor_id();
+	if (!token || (capture_mode != APSC_WFI_CLOCK &&
+		       capture_mode != APSC_WFI_MMIO))
+		goto out;
+	if (!smp_load_acquire(&capture_active)) {
+		atomic_inc(&wfi_prepare_after_stop);
+		goto out;
+	}
+	if (cpu >= APSC_CPUS) {
+		atomic_inc(&wfi_prepare_bad_mapping);
+		goto out;
+	}
+	cluster = READ_ONCE(cpu_cluster[cpu]);
+	if (cluster < 0 || cluster >= APSC_CLUSTERS || !cluster_base[cluster]) {
+		atomic_inc(&wfi_prepare_bad_mapping);
+		goto out;
+	}
+	stream = &wfi_stream[cpu];
+	index = atomic_fetch_inc_relaxed(&stream->attempts);
+	if (index >= stream->capacity)
+		goto out;
+	sample = &stream->samples[index];
+	sample->cmd_addr = cluster_base[cluster] + APSC_CMD_OFFSET;
+	sample->token = token;
+	sample->seq = index;
+	sample->cpu = cpu;
+	sample->cluster = cluster;
+	sample->mode = capture_mode == APSC_WFI_MMIO ? 2 : 1;
+out:
+	preempt_enable_no_resched_notrace();
+	return sample;
+}
