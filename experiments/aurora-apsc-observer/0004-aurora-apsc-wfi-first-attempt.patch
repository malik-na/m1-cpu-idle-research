+	seq_puts(s, "seq,cpu,cluster,token,t0,t1,cmd,mode\n");
+	for (cpu = 0; cpu < APSC_CPUS; cpu++) {
+		stream = &wfi_stream[cpu];
+		slots = min_t(u32, atomic_read(&stream->attempts), stream->capacity);
+		for (i = 0; i < slots; i++) {
+			e = &stream->samples[i];
+			if (!smp_load_acquire(&e->committed))
+				continue;
+			seq_printf(s, "%u,%u,%u,%llu,%llu,%llu,",
+				   e->seq, e->cpu, e->cluster, e->token, e->t0, e->t1);
