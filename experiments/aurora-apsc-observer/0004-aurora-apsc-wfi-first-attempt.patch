+				seq_printf(s, "0x%llx,", e->cmd);
+			else
+				seq_putc(s, ',');
+			seq_puts(s, e->mode == 2 ? "wfi_mmio\n" : "wfi_clock\n");
+		}
+	}
+	mutex_unlock(&capture_lock);
+	return 0;
+}
