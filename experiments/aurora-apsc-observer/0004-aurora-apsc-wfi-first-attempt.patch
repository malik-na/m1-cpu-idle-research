+static void apsc_wfi_stream_status(struct seq_file *s, int cpu)
+{
+	struct apsc_wfi_stream *stream = &wfi_stream[cpu];
+	u32 attempts = atomic_read(&stream->attempts);
+	u32 slots = min(attempts, stream->capacity);
+	u32 committed = 0, i;
+
+	for (i = 0; i < slots; i++)
+		committed += !!smp_load_acquire(&stream->samples[i].committed);
+	seq_printf(s, "wfi%d_attempts=%u\nwfi%d_committed=%u\n",
+		   cpu, attempts, cpu, committed);
+	seq_printf(s, "wfi%d_overflow=%u\nwfi%d_missing_commit=%u\n",
+		   cpu, attempts - slots, cpu, slots - committed);
