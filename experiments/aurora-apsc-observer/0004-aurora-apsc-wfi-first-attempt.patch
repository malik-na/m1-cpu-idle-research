+static u32 apsc_wfi_pending(void)
+{
+	u32 pending = 0, attempts, slots, i;
+	int cpu;
+
+	for (cpu = 0; cpu < APSC_CPUS; cpu++) {
+		attempts = atomic_read(&wfi_stream[cpu].attempts);
+		slots = min(attempts, wfi_stream[cpu].capacity);
+		for (i = 0; i < slots; i++)
+			pending += !smp_load_acquire(&wfi_stream[cpu].samples[i].committed);
+	}
+	return pending;
+}
