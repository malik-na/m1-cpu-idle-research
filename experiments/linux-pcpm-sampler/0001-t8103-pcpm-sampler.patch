+#endif
 };
 
 static const struct regmap_config syscon_regmap_config = {
@@ -48,6 +51,9 @@ static struct syscon *of_syscon_register(struct device_node *np, bool check_res)
 	struct resource res;
 	struct reset_control *reset;
 	resource_size_t res_size;
+#ifdef CONFIG_APPLE_PCPM_SAMPLER
+	bool clock_attached = false;
+#endif
 
 	WARN_ON(!mutex_is_locked(&syscon_list_lock));
 
@@ -133,6 +139,9 @@ static struct syscon *of_syscon_register(struct device_node *np, bool check_res)
 			ret = regmap_mmio_attach_clk(regmap, clk);
 			if (ret)
 				goto err_attach_clk;
+#ifdef CONFIG_APPLE_PCPM_SAMPLER
+			clock_attached = true;
+#endif
 		}
 
 		reset = of_reset_control_get_optional_exclusive(np, NULL);
@@ -148,6 +157,9 @@ static struct syscon *of_syscon_register(struct device_node *np, bool check_res)
 
 	syscon->regmap = regmap;
 	syscon->np = np;
+#ifdef CONFIG_APPLE_PCPM_SAMPLER
+	syscon->pcpm_clockless_mmio = !clock_attached;
+#endif
 
 	list_add_tail(&syscon->list, &syscon_list);
 
@@ -360,3 +372,27 @@ struct regmap *syscon_regmap_lookup_by_phandle_optional(struct device_node *np,
 	return regmap;
 }
 EXPORT_SYMBOL_GPL(syscon_regmap_lookup_by_phandle_optional);
+
+#ifdef CONFIG_APPLE_PCPM_SAMPLER
+/*
+ * Experiment-only lookup. Never register/map, attach clocks, or touch resets.
+ * External registrations remain ineligible (their kzalloc field stays false).
+ * Generic syscon maps in this pinned tree have boot lifetime; no unregister.
+ */
+struct regmap *syscon_node_to_existing_clockless_regmap(struct device_node *np)
+{
+	struct syscon *entry;
+	struct regmap *map = ERR_PTR(-EPROBE_DEFER);
+
+	mutex_lock(&syscon_list_lock);
+	list_for_each_entry(entry, &syscon_list, list) {
+		if (entry->np != np)
+			continue;
+		map = entry->pcpm_clockless_mmio ? entry->regmap :
+			ERR_PTR(-EOPNOTSUPP);
+		break;
+	}
+	mutex_unlock(&syscon_list_lock);
+	return map;
+}
+#endif
